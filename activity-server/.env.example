# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string.
DBURL="mongodb://localhost:27017/activity-tracker"

PORT=8000

# Interface to bind. Defaults to 127.0.0.1 when NODE_ENV=production, so only the
# reverse proxy on the same machine can reach the API. Do not set 0.0.0.0 on a
# public VPS: that publishes the API on this port directly, bypassing TLS,
# Cloudflare, and every nginx rule in front of it.
# HOST=127.0.0.1

NODE_ENV=production

# bcrypt cost. 12 is a reasonable default; higher is slower to log in.
SALT_WORK_FACTOR=12

# Generate each of these separately with:  openssl rand -base64 48
# They must differ from one another and be at least 32 characters.
# Production refuses to start if either is shorter.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_TTL=180m
REFRESH_TOKEN_TTL=90d

# Number of reverse proxies in front of this process, for Express `trust proxy`.
# 1 is correct for the documented nginx setup. This decides which address the
# auth rate limiter counts against, so if it is wrong every visitor shares one
# bucket and twenty failed sign-ins lock out everybody. nginx must also be
# configured to pass the real client address — see docs/deployment.md.
TRUST_PROXY=1

# Leave EMPTY when nginx serves the client and proxies /api on the same origin,
# which is the documented setup: the browser makes no cross-origin request, so
# there is nothing to allow. Only set this if the client is served from a
# different host to the API.
# CORS_ORIGINS=https://activity.example.com
