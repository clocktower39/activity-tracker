# Copy to .env.local for development, or set at build time for production.
# Every value is optional; the defaults are the documented subdomain deployment.

# Where the app is served from. "/" for a subdomain (the default).
# Use "/activity-tracker/" to build for the old sub-path deployment instead.
# This drives the asset base, the router basename and the PWA scope together.
# VITE_BASE_PATH=/

# ONLY needed when the API is on a different origin to the client. Left unset,
# the client calls /api on its own origin, which is what nginx serves, and no
# CORS configuration is involved anywhere.
# VITE_API_URL=https://api.example.com

# Where `yarn dev` proxies /api to. Development is same-origin through this
# proxy, so it behaves exactly like production.
# VITE_DEV_API=http://localhost:8000
